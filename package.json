{
  "name": "mintless",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny market town on NEAR where money emerges from barter and nobody, not even the developer, can print it.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "judge": "npm test && npm run proof && npm run verify:chain",
    "test": "node --test --test-reporter=spec \"test/**/*.test.js\"",
    "proof": "node scripts/proof.js",
    "verify:chain": "node scripts/verify-chain.js",
    "start": "node scripts/serve.js",
    "test:contract": "cd contract && cargo test",
    "build:contract": "cd contract && cargo build --target wasm32-unknown-unknown --release",
    "check:wasm": "node tools/wasm-check.mjs",
    "deploy:testnet": "npm --prefix tools install && node tools/chain.mjs",
    "bundle": "node scripts/bundle.js"
  }
}
